{
  "name": "@ministryofjustice/hmpps-electronic-monitoring-components",
  "version": "0.4.1",
  "description": "HMPPS Electronic Monitoring Frontend Components",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ministryofjustice/hmpps-electronic-monitoring-components.git"
  },
  "bugs": {
    "url": "https://github.com/ministryofjustice/hmpps-electronic-monitoring-components/issues"
  },
  "homepage": "https://github.com/ministryofjustice/hmpps-electronic-monitoring-components#readme",
  "main": "./dist/index.cjs.js",
  "module": "./dist/index.es.js",
  "types": "./dist/types/index.d.ts",
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "scripts": {
    "prepare": "husky",
    "lint": "eslint src --cache --max-warnings 0",
    "lint-fix": "eslint src --cache --max-warnings 0 --fix",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "test": "jest",
    "test:ci": "jest --runInBand",
    "int-test-init:ci": "cypress install",
    "int-test": "npm run build:css && cypress run --component --config-file integration_tests/cypress.config.ts",
    "int-test:ui": "npm run build:css && cypress open --component --browser chrome --config-file integration_tests/cypress.config.ts",
    "vite": "vite",
    "build:css": "set -e; for file in src/components/**/styles/[!_]*.scss; do sass --no-source-map --quiet-deps --load-path=node_modules \"$file\" \"${file%.scss}.raw.css\"; done",
    "watch:css": "chokidar --glob \"src/components/**/styles/**/*.scss\" -c \"npm run build:css --silent\"",
    "build": "rm -rf dist && npm run build:css && vite build && tsc -p tsconfig.build.json",
    "start-feature": "npm run build:css && storybook dev -p 6006",
    "build-storybook": "npm run build:css && storybook build",
    "setup": "npm ci && hmpps-npm-script-run-allowlist"
  },
  "keywords": [
    "web-component",
    "openlayers",
    "map",
    "moj",
    "govuk",
    "typescript",
    "frontend",
    "geodata",
    "gis",
    "component"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.cjs.js"
    },
    "./map": {
      "types": "./dist/types/components/map/scripts/index.d.ts",
      "import": "./dist/components/map/index.es.js",
      "require": "./dist/components/map/index.cjs.js"
    },
    "./map/layers": {
      "types": "./dist/types/components/map/scripts/core/layers/index.d.ts",
      "import": "./dist/components/map/layers/index.es.js",
      "require": "./dist/components/map/layers/index.cjs.js"
    },
    "./map/ordnance-survey-auth": {
      "types": "./dist/types/components/map/server/ordnance-survey-auth/index.d.ts",
      "import": "./dist/components/map/ordnance-survey-auth/index.es.js",
      "require": "./dist/components/map/ordnance-survey-auth/index.cjs.js"
    }
  },
  "files": [
    "dist/",
    "dist/index.*",
    "dist/map/",
    "dist/types/",
    "dist/nunjucks/"
  ],
  "license": "MIT",
  "dependencies": {
    "@types/qs": "^6.15.1",
    "axios": "1.19.0",
    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "maplibre-gl": "^5.24.0",
    "ol-mapbox-style": "^13.4.2",
    "superagent": "^10.3.0"
  },
  "devDependencies": {
    "@babel/plugin-transform-modules-systemjs": "7.29.8",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@chromatic-com/storybook": "^4.1.3",
    "@cypress/vite-dev-server": "^7.3.4",
    "@ministryofjustice/eslint-config-hmpps": "1.0.3",
    "@ministryofjustice/hmpps-npm-script-allowlist": "0.0.6",
    "@storybook/addon-a11y": "^10.5.7",
    "@storybook/addon-docs": "^10.5.7",
    "@storybook/addon-vitest": "^10.5.7",
    "@storybook/builder-vite": "10.5.7",
    "@storybook/web-components-vite": "^10.5.7",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/superagent": "^8.1.11",
    "@types/supertest": "^6.0.3",
    "@vitest/browser-playwright": "4.1.10",
    "@vitest/coverage-v8": "4.1.10",
    "babel-jest": "^30.4.1",
    "chokidar-cli": "^3.0.0",
    "cypress": "^15.20.0",
    "eslint": "^9.39.5",
    "eslint-plugin-storybook": "^10.5.7",
    "fast-glob": "^3.3.3",
    "govuk-frontend": "^5.14.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "jest-html-reporter": "^4.4.0",
    "jest-junit": "17.0.0",
    "jest-transform-stub": "^2.0.0",
    "lint-staged": "^16.4.0",
    "lit": "^3.3.3",
    "npm-run-all2": "^5.0.2",
    "ol": "10.10.0",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "prettier-plugin-jinja-template": "^2.2.0",
    "sass-embedded": "^1.100.0",
    "storybook": "^10.5.7",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vite-plugin-eslint2": "^5.3.0",
    "vite-plugin-static-copy": "^3.4.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "4.1.10"
  },
  "peerDependencies": {
    "govuk-frontend": ">=5.14.0",
    "ol": "10.8.x || 10.10.x"
  },
  "peerDependenciesMeta": {
    "ol": {
      "optional": false
    },
    "govuk-frontend": {
      "optional": false
    }
  },
  "overrides": {
    "@isaacs/brace-expansion": "^5.0.1",
    "brace-expansion": "^2.1.4",
    "glob": "^10.5.0",
    "handlebars": "^4.7.9",
    "picomatch": "^4.0.5",
    "qs": "^6.15.3",
    "flatted": "^3.4.4",
    "immutable": "^5.1.9",
    "path-to-regexp": "1.9.0"
  }
}
